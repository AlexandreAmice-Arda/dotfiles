errors=0
warnings=0

ok() { printf 'ok      %s\n' "$*"; }
warn() { printf 'warning %s\n' "$*"; warnings=$((warnings + 1)); }
fail() { printf 'error   %s\n' "$*"; errors=$((errors + 1)); }

require_command() {
    command -v "$1" >/dev/null 2>&1 && ok "$1" || fail "missing command: $1"
}

require_file() {
    [ -r "$1" ] && ok "file: $1" || fail "missing file: $1"
}

check_toml_file() {
    file=$1
    if ! command -v python3 >/dev/null 2>&1; then
        warn "python3 unavailable; cannot parse $file"
    elif python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' \
        "$file" >/dev/null 2>&1; then
        ok "valid TOML: $file"
    else
        fail "invalid TOML: $file"
    fi
}

check_shell_tooling() {
    for command_name in fzf zoxide starship atuin fd nvim tree-sitter cargo rustc; do
        require_command "$command_name"
    done
    require_file "$HOME/.config/starship.toml"
    require_file "$HOME/.config/atuin/config.toml"
    check_toml_file "$HOME/.config/starship.toml"
    check_toml_file "$HOME/.config/atuin/config.toml"

    if [ ! -r "$HOME/.local/share/atuin/key" ]; then
        warn 'Atuin has no local encryption key; log in before enabling sync'
    elif atuin status >/dev/null 2>&1; then
        ok 'Atuin account and local encryption key available'
    else
        warn 'Atuin account is not ready; run an interactive `atuin login`'
    fi

    if nvim_version=$(nvim --version 2>/dev/null | head -n 1); then
        ok "$nvim_version"
    else
        fail 'Neovim launcher cannot resolve an installed Neovim release'
    fi
    if tree_sitter_version=$(tree-sitter --version 2>/dev/null | head -n 1); then
        ok "$tree_sitter_version"
    else
        fail 'tree-sitter launcher cannot resolve a compatible CLI release'
    fi
}

check_tmux_config() {
    command -v tmux >/dev/null 2>&1 || return
    socket="desktop-doctor-$$"
    if tmux -L "$socket" -f "$HOME/.tmux.conf" new-session -d >/dev/null 2>&1; then
        tmux -L "$socket" kill-server >/dev/null 2>&1 || true
        ok 'tmux config valid'
    else
        fail 'tmux config invalid'
    fi
}

check_tmux_persistence() {
    require_file "$HOME/.tmux/plugins/tmux-resurrect/resurrect.tmux"
    require_file "$HOME/.tmux/plugins/tmux-continuum/continuum.tmux"
}

check_herdr() {
    require_command herdr
    require_file "$HOME/.config/herdr/config.toml"
    require_file "$HOME/.local/bin/terminal-agents"
    check_toml_file "$HOME/.config/herdr/config.toml"

    if herdr config check >/dev/null 2>&1; then
        ok 'Herdr config valid'
    else
        fail 'Herdr config invalid; run `herdr config check`'
    fi
    if ! "$HOME/.local/bin/terminal-agents" --check >/dev/null 2>&1; then
        fail 'GUI terminal cannot resolve Herdr'
    else
        ok 'GUI terminal can resolve Herdr'
    fi

    if [ -d "$HOME/.codex" ]; then
        integration_status=$(herdr integration status 2>/dev/null || true)
        if printf '%s\n' "$integration_status" | grep -Eq '^codex: (installed|current)'; then
            ok 'Herdr Codex integration installed'
        else
            warn 'Herdr Codex integration missing; run `chezmoi cd`, then `./scripts/install --agent-integrations`'
        fi
    fi
}

check_chezmoi_state() {
    command -v chezmoi >/dev/null 2>&1 || return
    if ! status_output=$(chezmoi status 2>&1); then
        fail "chezmoi status failed: $status_output"
        return
    else
        # Always-run initialization scripts are reported as R, and these two
        # existing XDG data directories are intentionally more private (0700)
        # than chezmoi's portable directory default (0755).
        status_output=$(printf '%s\n' "$status_output" | awk '
            $1 == "R" && $2 == "10_initialize_desktop_state.sh" { next }
            $1 == "M" && ($2 == ".local/share" || $2 == ".local/share/applications") { next }
            { print }
        ')
    fi

    if [ -n "$status_output" ]; then
        warn 'chezmoi-managed files differ from source; review `chezmoi status`'
    else
        ok 'chezmoi managed state clean'
    fi
}

finish() {
    printf '\nResult: %d error(s), %d warning(s)\n' "$errors" "$warnings"
    (( errors == 0 ))
}
