#!/usr/bin/env bash
set -euo pipefail

find_window() {
    swaymsg --raw --type get_tree | jq -r '
        [
          .. | objects
          | select(.type? == "con" or .type? == "floating_con")
          | select(
              ((.app_id // "") | test("^pcloud$"; "i")) or
              ((.window_properties.class // "") | test("^pcloud$"; "i"))
            )
        ]
        | (map(select(.focused)) + map(select(.urgent)) + .)
        | .[0].id // empty
    '
}

focus_window() {
    swaymsg --quiet -- "[con_id=$1] focus"
}

window_id=$(find_window)
if [[ ${FOCUS_HELPER_DRY_RUN:-0} == 1 ]]; then
    printf '%s\n' "$window_id"
    exit 0
fi
if [[ -n "$window_id" ]]; then
    focus_window "$window_id"
    exit 0
fi

# First give pCloud's single-instance handler a chance to recreate its window.
setsid --fork "$HOME/.config/pcloud/pcloud-launcher.sh" >/dev/null 2>&1
for _ in $(seq 1 20); do
    sleep 0.1
    window_id=$(find_window)
    if [[ -n "$window_id" ]]; then
        focus_window "$window_id"
        exit 0
    fi
done

# pCloud occasionally leaves its sync process alive after losing the Electron
# renderer. A clean restart is the only reliable recovery for that state.
pcloud_pattern="^$HOME/Downloads/pCloud[.]AppImage([[:space:]]|$)|^/tmp/[.]mount_pCloud[^/]*/pcloud[.]bin([[:space:]]|$)|^/proc/self/exe .*--user-data-dir=$HOME/[.]config/pcloud"
mapfile -t pcloud_pids < <(pgrep -f "$pcloud_pattern" || true)
if (( ${#pcloud_pids[@]} )); then
    kill -TERM "${pcloud_pids[@]}" 2>/dev/null || true
    for _ in $(seq 1 50); do
        pgrep -f "$pcloud_pattern" >/dev/null || break
        sleep 0.1
    done
fi
mapfile -t pcloud_pids < <(pgrep -f "$pcloud_pattern" || true)
if (( ${#pcloud_pids[@]} )); then
    kill -KILL "${pcloud_pids[@]}" 2>/dev/null || true
fi

setsid --fork "$HOME/.config/pcloud/pcloud-launcher.sh" >/dev/null 2>&1
for _ in $(seq 1 150); do
    sleep 0.1
    window_id=$(find_window)
    if [[ -n "$window_id" ]]; then
        focus_window "$window_id"
        exit 0
    fi
done

notify-send --urgency=critical 'pCloud window unavailable' \
    'pCloud restarted but did not create a focusable window.'
exit 1
