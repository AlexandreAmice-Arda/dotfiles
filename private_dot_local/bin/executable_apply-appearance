#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tokyo-night"
wallpaper_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tokyo-night/wallpapers"
mood_file="$state_dir/mood"
opacity_file="$state_dir/opacity"
foot_opacity_file="$state_dir/foot-opacity.ini"
quiet=0
requested_mood=""
requested_opacity=""

usage() {
    printf 'usage: %s [--restore] [--quiet] [--mood midnight|dusk|dawn] [--opacity 1.00|0.95|0.89]\n' "$0" >&2
}

while (( $# > 0 )); do
    case "$1" in
        --restore) ;;
        --quiet) quiet=1 ;;
        --mood)
            (( $# >= 2 )) || { usage; exit 2; }
            requested_mood=$2
            shift
            ;;
        --opacity)
            (( $# >= 2 )) || { usage; exit 2; }
            requested_opacity=$2
            shift
            ;;
        *) usage; exit 2 ;;
    esac
    shift
done

mkdir -p "$state_dir"

mood=${requested_mood:-$(cat "$mood_file" 2>/dev/null || printf midnight)}
opacity=${requested_opacity:-$(cat "$opacity_file" 2>/dev/null || printf 0.95)}

case "$mood" in midnight|dusk|dawn) ;; *) mood=midnight ;; esac
case "$opacity" in 1.00|0.95|0.89) ;; *) opacity=0.95 ;; esac

landscape="$wallpaper_dir/$mood.png"
portrait="$wallpaper_dir/$mood-portrait.png"
[[ -r "$landscape" ]] || { printf 'missing wallpaper: %s\n' "$landscape" >&2; exit 1; }
[[ -r "$portrait" ]] || portrait=$landscape

printf '%s\n' "$mood" > "$mood_file"
printf '%s\n' "$opacity" > "$opacity_file"
ln -sfn -- "$landscape" "$state_dir/wallpaper.png"

opacity_tmp=$(mktemp "$state_dir/.foot-opacity.XXXXXX")
printf '[colors]\nalpha=%s\n' "$opacity" > "$opacity_tmp"
mv -f -- "$opacity_tmp" "$foot_opacity_file"

if command -v swaymsg >/dev/null 2>&1 && [[ -n ${SWAYSOCK:-} ]]; then
    while IFS=$'\t' read -r output transform; do
        [[ -n "$output" ]] || continue
        case "$transform" in 90|270|flipped-90|flipped-270) image=$portrait ;; *) image=$landscape ;; esac
        swaymsg -- output "$output" bg "$image" fill >/dev/null
    done < <(swaymsg --raw --type get_outputs \
        | jq -r '.[] | select(.active) | [.name, .transform] | @tsv')
fi

if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme Yaru-purple-dark >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface cursor-theme Adwaita >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface cursor-size 24 >/dev/null 2>&1 || true
fi

if (( quiet == 0 )) && command -v notify-send >/dev/null 2>&1; then
    notify-send "Appearance · ${mood^}" "Terminal opacity: ${opacity}. New Foot windows use the change."
fi
