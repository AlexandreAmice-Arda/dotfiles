#!/usr/bin/env bash
set -u

doctor_lib="$HOME/.local/libexec/desktop-doctor"
# shellcheck source=/dev/null
source "$doctor_lib/common"

printf 'Desktop doctor\nOS: %s  Architecture: %s\n\n' "$(uname -s)" "$(uname -m)"

case $(uname -s) in
    Darwin) source "$doctor_lib/darwin" ;;
    Linux) source "$doctor_lib/linux" ;;
    *) fail "unsupported operating system: $(uname -s)" ;;
esac

check_tmux_config
check_chezmoi_state
finish
