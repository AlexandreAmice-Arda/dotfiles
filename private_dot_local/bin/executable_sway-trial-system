#!/bin/sh
set -eu

session_source="$HOME/.local/share/wayland-sessions/sway-intel.desktop"
session_target="/usr/share/wayland-sessions/sway-intel.desktop"

case "${1:-status}" in
    install)
        sudo install -m 0644 "$session_source" "$session_target"
        sudo systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service
        ;;
    status)
        if [ -f "$session_target" ]; then
            printf 'custom_session=installed\n'
        else
            printf 'custom_session=missing\n'
        fi
        systemctl is-enabled nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service || true
        ;;
    rollback)
        sudo rm -f -- "$session_target"
        sudo systemctl disable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service
        ;;
    *)
        printf 'usage: %s {install|status|rollback}\n' "$0" >&2
        exit 2
        ;;
esac
