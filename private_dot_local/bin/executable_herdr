#!/bin/sh
set -eu

# Prefer a package-manager installation. The pinned Linux release is the
# portable fallback because Ubuntu does not currently package Herdr.
for candidate in \
    /opt/homebrew/bin/herdr \
    /usr/local/bin/herdr \
    /usr/bin/herdr \
    "$HOME/.local/opt/herdr-0.9.1/herdr"
do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

printf 'herdr: no native or managed binary found\n' >&2
exit 127
