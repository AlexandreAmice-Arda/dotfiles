#!/bin/sh
set -eu

for candidate in /usr/local/bin/ghostty /usr/bin/ghostty /snap/bin/ghostty; do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

prefix="$HOME/.local/opt/ghostty-1.3.1"
if [ ! -x "$prefix/AppRun" ]; then
    printf 'ghostty: run scripts/install-ghostty from the dotfiles repository\n' >&2
    exit 127
fi

exec "$prefix/AppRun" "$@"
