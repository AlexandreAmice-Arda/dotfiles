#!/usr/bin/env bash
set -euo pipefail

shell_root="${TOKYO_NIGHT_SHELL_ROOT:-$HOME/.local/opt/tokyo-night-shell}"
for executable in /usr/bin/waybar /usr/local/bin/waybar "$shell_root/usr/bin/waybar"; do
    [[ -x "$executable" ]] || continue
    if [[ "$executable" == "$shell_root"/* ]]; then
        export LD_LIBRARY_PATH="$shell_root/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        export XDG_DATA_DIRS="$shell_root/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
    fi
    # Replacing the wrapper is intentional; there is nothing to clean up.
    # shellcheck disable=SC2093
    exec "$executable" "$@"
done
printf 'waybar is not installed\n' >&2
exit 127
