#!/bin/sh
set -eu

for slack_binary in /usr/bin/slack /snap/bin/slack; do
    if [ -x "$slack_binary" ]; then
        # Slack can start its tray icon without mapping a Wayland window on NVIDIA.
        exec "$slack_binary" --disable-gpu "$@"
    fi
done

printf 'Slack is not installed. Run scripts/install.\n' >&2
exit 127
