# Small, native zsh layer. Shared PATH setup lives in ~/.profile.

HISTFILE="$HOME/.zsh_history"
HISTSIZE=2000
SAVEHIST=2000
setopt append_history hist_ignore_dups

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

autoload -Uz compinit && compinit

if command -v herdr >/dev/null 2>&1; then
    source <(command herdr completion zsh)
fi

# fzf keeps file/directory widgets and completion. Atuin is initialized last
# so it owns Ctrl-R without replacing the normal Up-arrow history behavior.
if command -v fzf >/dev/null 2>&1; then
    if fzf_shell_init=$(fzf --zsh 2>/dev/null); then
        eval "$fzf_shell_init"
    else
        for fzf_script in \
            /usr/share/doc/fzf/examples/completion.zsh \
            /usr/share/doc/fzf/examples/key-bindings.zsh
        do
            [ -r "$fzf_script" ] && source "$fzf_script"
        done
        unset fzf_script
    fi
    unset fzf_shell_init
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi
if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
fi

# Ghostty sends xterm-style Ctrl+Arrow sequences for word navigation.
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
