#!/usr/bin/env bash
set -euo pipefail

source_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
work_dir=$(mktemp -d)
trap 'rm -rf -- "$work_dir"' EXIT

render() {
    chezmoi execute-template < "$source_root/$1" > "$work_dir/$2"
    printf 'ok      rendered %s\n' "$1"
}

chezmoi --override-data '{"desktopProfile":"portable"}' execute-template \
    < "$source_root/private_dot_config/sway/config.tmpl" > "$work_dir/sway-portable.conf"
printf 'ok      rendered Sway portable profile\n'
chezmoi --override-data '{"desktopProfile":"amice-workstation"}' execute-template \
    < "$source_root/private_dot_config/sway/config.tmpl" > "$work_dir/sway-workstation.conf"
printf 'ok      rendered Sway workstation profile\n'
render private_dot_config/foot/foot.ini.tmpl foot.ini
render private_dot_config/aerospace/aerospace.toml.tmpl aerospace.toml
render private_dot_config/ghostty/config.tmpl ghostty.conf
chezmoi --override-data '{"desktopProfile":"portable"}' execute-template \
    < "$source_root/private_dot_config/sway/scripts/executable_start-waybar.tmpl" > "$work_dir/start-waybar-portable"
chezmoi --override-data '{"desktopProfile":"amice-workstation"}' execute-template \
    < "$source_root/private_dot_config/sway/scripts/executable_start-waybar.tmpl" > "$work_dir/start-waybar-workstation"
printf 'ok      rendered both Waybar launch profiles\n'

if command -v sway >/dev/null 2>&1; then
    sway --unsupported-gpu --validate --config "$work_dir/sway-portable.conf"
    sway --unsupported-gpu --validate --config "$work_dir/sway-workstation.conf"
    printf 'ok      both Sway profiles\n'
fi

if command -v foot >/dev/null 2>&1; then
    foot --check-config --config "$work_dir/foot.ini"
    printf 'ok      Foot config\n'
fi

if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' "$work_dir/aerospace.toml"
    printf 'ok      AeroSpace TOML\n'
fi

for json_file in \
    "$source_root/private_dot_config/waybar/config.json" \
    "$source_root/private_dot_config/swaync/config.json"
do
    jq empty "$json_file"
    printf 'ok      JSON %s\n' "${json_file#"$source_root/"}"
done

while IFS= read -r script; do
    bash -n "$script"
done < <(find "$source_root/private_dot_local/bin" "$source_root/private_dot_config/sway/scripts" \
    -type f -name 'executable_*' ! -name '*.tmpl' -print)
bash -n "$work_dir/start-waybar-portable" "$work_dir/start-waybar-workstation"
printf 'ok      shell syntax\n'

if command -v git >/dev/null 2>&1; then
    git -C "$source_root" diff --check
    printf 'ok      whitespace\n'
fi

printf '\nDesktop source validation passed.\n'
