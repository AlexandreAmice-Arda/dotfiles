{
  "name": "send-editor-to-sway-workspace",
  "displayName": "Send Editor to Sway Workspace",
  "description": "Move the active text editor between the VS Code windows on Sway workspaces 1-4.",
  "version": "0.1.0",
  "publisher": "amice",
  "license": "MIT",
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:sendEditorToSway.workspace1",
    "onCommand:sendEditorToSway.workspace2",
    "onCommand:sendEditorToSway.workspace3",
    "onCommand:sendEditorToSway.workspace4"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sendEditorToSway.workspace1",
        "title": "Send Active Editor to Workspace 1",
        "category": "Sway"
      },
      {
        "command": "sendEditorToSway.workspace2",
        "title": "Send Active Editor to Workspace 2",
        "category": "Sway"
      },
      {
        "command": "sendEditorToSway.workspace3",
        "title": "Send Active Editor to Workspace 3",
        "category": "Sway"
      },
      {
        "command": "sendEditorToSway.workspace4",
        "title": "Send Active Editor to Workspace 4",
        "category": "Sway"
      }
    ],
    "keybindings": [
      {
        "command": "sendEditorToSway.workspace1",
        "key": "ctrl+alt+1",
        "when": "editorTextFocus"
      },
      {
        "command": "sendEditorToSway.workspace2",
        "key": "ctrl+alt+2",
        "when": "editorTextFocus"
      },
      {
        "command": "sendEditorToSway.workspace3",
        "key": "ctrl+alt+3",
        "when": "editorTextFocus"
      },
      {
        "command": "sendEditorToSway.workspace4",
        "key": "ctrl+alt+4",
        "when": "editorTextFocus"
      }
    ]
  }
}
