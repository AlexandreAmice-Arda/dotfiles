#!/bin/sh
set -eu

# Keep the newer Wayland libraries private to this desktop stack. Bump the
# directory revision when changing pins; never rebuild an active stack in place.
repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
manifest="$repo_dir/packages/sway-stack-sources.tsv"
stack_root="$HOME/.local/lib/sway-stack"
prefix="$stack_root/1.11"
fingerprint=$(sha256sum "$manifest" | awk '{print $1}')

activate() {
    "$prefix/bin/sway" --version
    "$prefix/bin/gtklock" --version
    "$prefix/bin/gtklock" --modules="$prefix/lib/gtklock/powerbar-module.so" \
        --help-powerbar >/dev/null
    # Rename the link only after all components are usable.
    ln -s "$prefix" "$stack_root/current.new.$$"
    mv -Tf "$stack_root/current.new.$$" "$stack_root/current"
}

if [ -r "$prefix/ready" ]; then
    [ "$(cat "$prefix/ready")" = "$fingerprint" ] || {
        printf 'Sway stack pins changed; use a new installation directory revision.\n' >&2
        exit 1
    }
    activate
    exit 0
fi

missing_packages=
for package in build-essential meson ninja-build pkg-config curl python3 \
    libxkbcommon-dev libdrm-dev libinput-dev libseat-dev libpcre2-dev \
    libjson-c-dev libgtk-3-dev libpam0g-dev libxcb-icccm4-dev libxcb-res0-dev \
    libxcb-composite0-dev libxcb-ewmh-dev libdisplay-info-dev hwdata \
    scdoc gettext libegl-dev libgbm-dev libgles-dev libevdev-dev \
    libwacom-dev libmtdev-dev libudev-dev libexpat1-dev libffi-dev; do
    if ! dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null \
        | grep -q '^ii '; then
        missing_packages="$missing_packages $package"
    fi
done
if [ -n "$missing_packages" ]; then
    sudo apt-get update
    # shellcheck disable=SC2086
    sudo apt-get install -y $missing_packages
fi

build_root=$(mktemp -d)
trap 'rm -rf -- "$build_root"' EXIT
PATH="$prefix/bin:$PATH"
PKG_CONFIG_PATH="$prefix/lib/pkgconfig:$prefix/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export PATH PKG_CONFIG_PATH

while IFS="$(printf '\t')" read -r component version checksum url; do
    printf 'Building %s %s\n' "$component" "$version"
    archive="$build_root/$component.tar.gz"
    source_dir="$build_root/$component"
    curl --fail --location --show-error --output "$archive" "$url"
    if ! printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --status -; then
        printf '%s source checksum failed\n' "$component" >&2
        exit 1
    fi
    mkdir -p "$source_dir"
    tar -xzf "$archive" -C "$source_dir" --strip-components=1
    case "$component" in
        wayland) set -- -Ddocumentation=false -Dtests=false ;;
        protocols) set -- -Dtests=false ;;
        pixman) set -- -Dtests=disabled -Ddemos=disabled ;;
        libinput) set -- -Dtests=false -Ddocumentation=false -Ddebug-gui=false ;;
        wlroots)
            set -- -Dexamples=false -Dbackends=drm,libinput -Drenderers=gles2 \
                -Dallocators=gbm -Dxwayland=enabled -Dlibliftoff=disabled \
                -Dcolor-management=disabled
            ;;
        sway) set -- -Dswaybar=false -Ddefault-wallpaper=false -Dman-pages=disabled ;;
        gtk-session-lock) set -- -Dintrospection=false -Dvapi=false -Ddocs=false ;;
        gtklock|powerbar) set -- ;;
        *) printf 'Unknown Sway stack component: %s\n' "$component" >&2; exit 1 ;;
    esac
    meson setup "$source_dir/build" "$source_dir" \
        --prefix="$prefix" --libdir=lib --sysconfdir="$prefix/etc" \
        --buildtype=release --wrap-mode=nodownload \
        "-Dc_link_args=-Wl,-rpath,$prefix/lib" "$@"
    meson compile -C "$source_dir/build" -j 8
    meson install -C "$source_dir/build"
done < "$manifest"

for binary in sway gtklock; do
    if ldd "$prefix/bin/$binary" | grep -q 'not found'; then
        printf 'Missing runtime dependency for %s\n' "$binary" >&2
        exit 1
    fi
done
[ -r /etc/pam.d/gtklock ] || {
    printf 'Install the Ubuntu gtklock package to supply its PAM configuration.\n' >&2
    exit 1
}
"$prefix/bin/sway" --version
"$prefix/bin/gtklock" --modules="$prefix/lib/gtklock/powerbar-module.so" \
    --help-powerbar >/dev/null
printf '%s\n' "$fingerprint" > "$prefix/ready"
activate
