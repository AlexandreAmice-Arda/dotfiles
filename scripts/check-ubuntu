#!/bin/sh
set -eu

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
manifest="$repo_dir/packages/ubuntu.txt"
missing=0
checked=0

while IFS= read -r package; do
    case "$package" in
        ''|'#'*) continue ;;
    esac
    checked=$((checked + 1))
    status=$(dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null || true)
    if [ "$status" != ii\  ]; then
        printf 'missing %s\n' "$package" >&2
        missing=$((missing + 1))
    fi
done < "$manifest"

if [ "$missing" -ne 0 ]; then
    printf '%d of %d Ubuntu packages are missing. Run scripts/install-ubuntu.\n' \
        "$missing" "$checked" >&2
    exit 1
fi

printf 'All %d Ubuntu manifest packages are installed.\n' "$checked"

if [ "$(dpkg --print-architecture)" = amd64 ]; then
    status=$(dpkg-query -W -f='${db:Status-Abbrev}' signal-desktop 2>/dev/null || true)
    if [ "$status" != ii\  ]; then
        printf 'missing signal-desktop\n' >&2
        exit 1
    fi
fi
if [ ! -x /usr/bin/slack ] && ! snap list slack >/dev/null 2>&1; then
    printf 'missing slack\n' >&2
    exit 1
fi
if [ "$(dpkg --print-architecture)" = amd64 ] \
    && [ ! -x "$HOME/.local/opt/pcloud/pCloud.AppImage" ]; then
    printf 'missing pCloud Drive AppImage\n' >&2
    exit 1
fi
printf 'Shared desktop applications are installed.\n'
