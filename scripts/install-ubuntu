#!/bin/sh
set -eu

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
grant_backlight=0
minimum_version=$(awk '$1 == "ubuntu_minimum:" { gsub(/"/, "", $2); print $2; exit }' \
    "$repo_dir/.chezmoidata.yaml")
[ -n "$minimum_version" ] || {
    printf 'Could not read desktop.support.ubuntu_minimum.\n' >&2
    exit 1
}

case "${1:-}" in
    "") ;;
    --grant-backlight) grant_backlight=1 ;;
    *) printf 'usage: %s [--grant-backlight]\n' "$0" >&2; exit 2 ;;
esac

if [ "$(uname -s)" != Linux ] || [ ! -r /etc/os-release ]; then
    printf 'This installer supports Ubuntu only.\n' >&2
    exit 1
fi

# shellcheck disable=SC1091
. /etc/os-release
if [ "${ID:-}" != ubuntu ]; then
    printf 'Unsupported Linux distribution: %s\n' "${ID:-unknown}" >&2
    exit 1
fi
if ! dpkg --compare-versions "${VERSION_ID:-0}" ge "$minimum_version"; then
    printf 'Ubuntu %s is unsupported; Ubuntu %s or newer is required.\n' \
        "${VERSION_ID:-unknown}" "$minimum_version" >&2
    exit 1
fi

packages=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$repo_dir/packages/ubuntu.txt")
sudo apt-get update
sudo apt-get install -y software-properties-common wget gpg
sudo add-apt-repository -y universe

install_temp_dir=$(mktemp -d)
trap 'rm -rf -- "$install_temp_dir"' EXIT
wget -qO "$install_temp_dir/microsoft.asc" \
    https://packages.microsoft.com/keys/microsoft.asc
gpg --batch --dearmor \
    --output "$install_temp_dir/microsoft.gpg" \
    "$install_temp_dir/microsoft.asc"
sudo install -o root -g root -m 0644 \
    "$install_temp_dir/microsoft.gpg" /usr/share/keyrings/microsoft.gpg
sudo install -o root -g root -m 0644 \
    "$repo_dir/packages/vscode.sources" /etc/apt/sources.list.d/vscode.sources

install_signal=0
if [ "$(dpkg --print-architecture)" = amd64 ]; then
    install_signal=1
    wget -qO "$install_temp_dir/signal.asc" \
        https://updates.signal.org/desktop/apt/keys.asc
    gpg --batch --dearmor \
        --output "$install_temp_dir/signal-desktop-keyring.gpg" \
        "$install_temp_dir/signal.asc"
    sudo install -o root -g root -m 0644 \
        "$install_temp_dir/signal-desktop-keyring.gpg" \
        /usr/share/keyrings/signal-desktop-keyring.gpg
    sudo install -o root -g root -m 0644 \
        "$repo_dir/packages/signal-desktop.sources" \
        /etc/apt/sources.list.d/signal-desktop.sources
else
    printf 'Signal Desktop is unavailable from its Ubuntu repository on %s; skipping it.\n' \
        "$(dpkg --print-architecture)" >&2
fi

sudo apt-get update
# shellcheck disable=SC2086
sudo apt-get install -y $packages
if [ "$install_signal" -eq 1 ]; then
    sudo apt-get install -y signal-desktop
fi
if [ ! -x /usr/bin/slack ] && ! snap list slack >/dev/null 2>&1; then
    if ! command -v snap >/dev/null 2>&1; then
        sudo apt-get install -y snapd
    fi
    sudo snap install slack
fi

if [ "$(dpkg --print-architecture)" = amd64 ]; then
    pcloud_public_code='XZrYdRJZLS6RF4kf6Jy6GFr4jqkc4S34Rlgy'
    pcloud_sha256='07e404be9e37ef2dffb6541fea74f10601f2a33fe490bcaa895fb5b238f81af6'
    pcloud_download=$(curl --fail --silent --show-error \
        "https://api.pcloud.com/getpublinkdownload?code=$pcloud_public_code")
    pcloud_host=$(printf '%s' "$pcloud_download" | jq -er '.hosts[0]')
    pcloud_path=$(printf '%s' "$pcloud_download" | jq -er '.path')
    pcloud_tag=$(printf '%s' "$pcloud_download" | jq -er '.dwltag')
    curl --fail --location --show-error \
        --output "$install_temp_dir/pCloud.AppImage" \
        "https://$pcloud_host$pcloud_path?dwltag=$pcloud_tag"
    printf '%s  %s\n' "$pcloud_sha256" "$install_temp_dir/pCloud.AppImage" \
        | sha256sum --check --status -
    install -d -m 0755 "$HOME/.local/opt/pcloud"
    install -m 0755 "$install_temp_dir/pCloud.AppImage" \
        "$HOME/.local/opt/pcloud/pCloud.AppImage"
else
    printf 'pCloud Drive AppImage is unavailable on %s; skipping it.\n' \
        "$(dpkg --print-architecture)" >&2
fi

"$repo_dir/scripts/check-ubuntu"

has_backlight=0
find /sys/class/backlight -mindepth 1 -maxdepth 1 -print -quit | grep -q . \
    && has_backlight=1

video_members=$(getent group video 2>/dev/null | cut -d: -f4 || true)
case ",$video_members," in
    *,"$USER",*) video_membership_recorded=1 ;;
    *) video_membership_recorded=0 ;;
esac

if [ "$grant_backlight" -eq 1 ] && [ "$has_backlight" -eq 1 ]; then
    if id -nG "$USER" | tr ' ' '\n' | grep -qx video; then
        printf 'Backlight group access is already active for %s.\n' "$USER"
    elif [ "$video_membership_recorded" -eq 0 ]; then
        sudo usermod -aG video "$USER"
        printf 'Added %s to the video group; log out completely before testing brightness.\n' "$USER"
    else
        printf 'Backlight group access is recorded; log out completely, then log in.\n'
    fi
elif [ "$grant_backlight" -eq 0 ] && [ "$has_backlight" -eq 1 ]; then
    printf 'Backlight access was not changed. If brightness is denied, rerun with --grant-backlight.\n'
fi

printf "Ubuntu desktop dependencies installed. Run 'chezmoi apply', then 'desktop-doctor'.\n"
