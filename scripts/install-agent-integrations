#!/bin/sh
set -eu

if [ ! -d "$HOME/.codex" ]; then
    printf 'Codex config directory is missing: %s/.codex\n' "$HOME" >&2
    printf 'Start Codex once, then rerun this installer.\n' >&2
    exit 1
fi

herdr_bin=
for candidate in \
    "$HOME/.local/bin/herdr" \
    /opt/homebrew/bin/herdr \
    /usr/local/bin/herdr \
    /usr/bin/herdr
do
    if [ -x "$candidate" ]; then
        herdr_bin=$candidate
        break
    fi
done

if [ -z "$herdr_bin" ]; then
    printf 'Herdr is not installed; apply the dotfiles first.\n' >&2
    exit 127
fi

"$herdr_bin" integration install codex
status=$("$herdr_bin" integration status)
printf '%s\n' "$status"
printf '%s\n' "$status" | grep -Eq '^codex: (installed|current)' || {
    printf 'Herdr did not report a working Codex integration.\n' >&2
    exit 1
}
