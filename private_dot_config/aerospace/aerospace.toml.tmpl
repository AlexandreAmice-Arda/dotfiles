# Generated by chezmoi from the shared desktop schema in .chezmoidata.yaml.
config-version = 2
start-at-login = true
auto-reload-config = true

after-login-command = []
after-startup-command = [
    'exec-and-forget open -a Slack',
    'exec-and-forget open -a Signal',
]

enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true
accordion-padding = 28
default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'
on-focused-monitor-changed = ['move-mouse monitor-lazy-center']
persistent-workspaces = [{{ range $index, $workspace := .desktop.workspaces }}{{ if $index }}, {{ end }}'{{ $workspace.name }}'{{ end }}]

[key-mapping]
preset = 'qwerty'

[gaps]
inner.horizontal = {{ .desktop.layout.gaps_inner }}
inner.vertical = {{ .desktop.layout.gaps_inner }}
outer.left = {{ .desktop.layout.gaps_outer }}
outer.bottom = {{ .desktop.layout.gaps_outer }}
outer.top = {{ .desktop.layout.gaps_outer }}
outer.right = {{ .desktop.layout.gaps_outer }}

[mode.main.binding]
alt-t = 'exec-and-forget open -na Ghostty'
alt-shift-t = 'exec-and-forget open -na Ghostty --args -e {{ .chezmoi.homeDir }}/.local/bin/terminal-main'
alt-ctrl-t = 'exec-and-forget open -na Ghostty --args -e {{ .chezmoi.homeDir }}/.local/bin/terminal-agents'
alt-slash = 'layout tiles horizontal vertical'
alt-comma = 'layout accordion horizontal vertical'
alt-f = 'fullscreen'
alt-shift-f = 'layout floating tiling'
alt-shift-q = 'close'
alt-r = 'mode resize'

{{ range .desktop.directions }}
alt-{{ .key }} = 'focus {{ .name }}'
alt-shift-{{ .key }} = 'move {{ .name }}'
{{ end }}
{{ range .desktop.workspaces }}
alt-{{ .key }} = 'workspace {{ .name }}'
alt-shift-{{ .key }} = 'move-node-to-workspace {{ .name }}'
{{ end }}

[[on-window-detected]]
if.app-id = 'com.tinyspeck.slackmacgap'
run = 'move-node-to-workspace 10'

[[on-window-detected]]
if.app-id = 'org.whispersystems.signal-desktop'
run = 'move-node-to-workspace 10'

[mode.resize.binding]
h = 'resize width -50'
j = 'resize height +50'
k = 'resize height -50'
l = 'resize width +50'
enter = 'mode main'
esc = 'mode main'
