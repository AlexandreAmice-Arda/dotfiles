# Generated by chezmoi from the shared desktop schema in .chezmoidata.yaml.
config-version = 2
start-at-login = true
auto-reload-config = true

after-login-command = []
after-startup-command = [
    'exec-and-forget open -a Slack',
]

enable-normalization-flatten-containers = false
enable-normalization-opposite-orientation-for-nested-containers = true
accordion-padding = 28
default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'
on-focused-monitor-changed = ['move-mouse monitor-lazy-center']
persistent-workspaces = [{{ range $index, $workspace := .desktop.workspaces }}{{ if $index }}, {{ end }}'{{ $workspace.name }}'{{ end }}]

[key-mapping]
preset = 'qwerty'

[gaps]
inner.horizontal = {{ .desktop.layout.gaps_inner }}
inner.vertical = {{ .desktop.layout.gaps_inner }}
outer.left = {{ .desktop.layout.gaps_outer }}
outer.bottom = {{ .desktop.layout.gaps_outer }}
outer.top = {{ .desktop.layout.gaps_outer }}
outer.right = {{ .desktop.layout.gaps_outer }}

# Super is Command on macOS, matching Sway's Super modifier.
[mode.main.binding]
#@ Apps: Open a plain terminal
cmd-t = 'exec-and-forget open -na Ghostty'
#@ Apps: Open or resume a persistent tmux terminal
cmd-shift-t = 'exec-and-forget open -na Ghostty --args -e {{ .chezmoi.homeDir }}/.local/bin/terminal-main'
#@ Apps: Open the Herdr agent workspace
cmd-ctrl-t = 'exec-and-forget open -na Ghostty --args -e {{ .chezmoi.homeDir }}/.local/bin/terminal-agents'
#@ Apps: Open application launcher
# Apps opens Spotlight's visible launcher; opening Spotlight.app alone may show no panel.
cmd-d = 'exec-and-forget open -a /System/Applications/Apps.app'
#@ Apps: Search desktop commands and shortcuts
cmd-slash = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/desktop-commands'
#@ System: Open system settings
# Keep native Command+C/V/X clipboard shortcuts available to applications.
cmd-ctrl-c = 'exec-and-forget open -a "System Settings"'
#@ System: Reload desktop configuration
cmd-shift-c = 'reload-config'
#@ Windows: Close focused window
cmd-alt-q = 'close'
#@ Layout: Toggle horizontal and vertical tiles
cmd-e = 'layout tiles horizontal vertical'
#@ Layout: Stack windows vertically
cmd-s = 'layout v_accordion'
#@ Layout: Stack windows horizontally
cmd-w = 'layout h_accordion'
#@ Layout: Split side-by-side
cmd-alt-b = 'split horizontal'
#@ Layout: Split top-to-bottom
cmd-alt-v = 'split vertical'
#@ Layout: Toggle fullscreen
cmd-f = 'fullscreen'
#@ Layout: Toggle floating
cmd-shift-f = 'layout floating tiling'
#@ Layout: Enter resize mode
cmd-r = 'mode resize'
#@ Workspaces: Return to previous workspace
cmd-tab = 'workspace-back-and-forth'

{{ range .desktop.directions }}
#@ Windows: Focus {{ .name }}
cmd-{{ .key }} = 'focus {{ .name }}'
#@ Windows: Move window {{ .name }}
cmd-alt-{{ .key }} = 'move {{ .name }}'
#@ Workspaces: Move workspace to monitor {{ .name }}
cmd-ctrl-{{ .key }} = 'move-workspace-to-monitor {{ .name }}'
{{ end }}
{{ range .desktop.workspaces }}
#@ Workspaces: Switch to workspace {{ .name }}
cmd-{{ .key }} = 'workspace {{ .name }}'
#@ Workspaces: Move window to workspace {{ .name }}
cmd-shift-{{ .key }} = 'move-node-to-workspace {{ .name }}'
{{ end }}

# Override automatic dialog floating for every detected window.
[[on-window-detected]]
check-further-callbacks = true
run = 'layout tiling'

[[on-window-detected]]
if.app-id = 'com.tinyspeck.slackmacgap'
run = 'move-node-to-workspace 10'

[mode.resize.binding]
h = 'resize width -50'
j = 'resize height +50'
k = 'resize height -50'
l = 'resize width +50'
enter = 'mode main'
esc = 'mode main'
