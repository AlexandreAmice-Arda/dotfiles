"$schema" = "https://starship.rs/config-schema.json"
add_newline = false

# Untruncated directory, command context, and a clean input glyph each get a line.
format = """
${custom.remote}\
$directory\
$line_break\
$git_branch\
$git_status\
$cmd_duration\
$line_break\
$character"""

[custom.remote]
when = 'test -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}"'
command = 'printf "%s@%s" "$USER" "$(hostname -s)"'
style = "bold #{{ .desktop.theme.cyan }}"
format = "[$output]($style)\n"
shell = ["sh"]

[directory]
style = "bold #{{ .desktop.theme.blue }}"
format = "[$path]($style)"
truncation_length = 0
truncate_to_repo = false

[git_branch]
symbol = ""
style = "#{{ .desktop.theme.purple }}"
format = "[  $symbol $branch]($style)"

[git_status]
style = "#{{ .desktop.theme.pink }}"
format = "[($all_status$ahead_behind)]($style)"

[cmd_duration]
min_time = 2000
style = "#{{ .desktop.theme.muted }}"
format = "[  $duration]($style)"

[character]
success_symbol = "[❯](bold #{{ .desktop.theme.green }})"
error_symbol = "[❯](bold #{{ .desktop.theme.pink }})"
