#!/usr/bin/env bash
set -euo pipefail

config="${SWAY_CONFIG_PATH:-$HOME/.config/sway/config}"
config_dir=$(dirname -- "$config")
shopt -s nullglob
config_files=("$config" "$config_dir"/conf.d/*.conf)

catalog=$(awk '
    /^[[:space:]]*#@[[:space:]]*/ {
        line=$0
        sub(/^[[:space:]]*#@[[:space:]]*/, "", line)
        count=split(line, fields, /[[:space:]]+::[[:space:]]+/)
        if (count >= 2) {
            command=""
            if (count >= 3) command=fields[3]
            for (i=4; i<=count; i++) command=command " :: " fields[i]
            reference = command == "" ? " [reference only]" : ""
            printf "%s — %s%s\t%s\n", fields[2], fields[1], reference, command
        }
    }
' "${config_files[@]}")

if [[ ${1:-} == --print ]]; then
    printf '%s\n' "$catalog" | cut -f1
    exit 0
fi

selection=$(printf '%s\n' "$catalog" \
    | cut -f1 \
    | wofi --dmenu --prompt "Search actions · Enter selects · Esc closes" \
        --matching multi-contains --insensitive \
        --width 60% --height 70% --cache-file /dev/null) || exit 0

[[ -n "$selection" ]] || exit 0
command=$(printf '%s\n' "$catalog" \
    | awk -F '\t' -v selection="$selection" '$1 == selection {print substr($0, index($0, "\t") + 1); exit}')

[[ -n "$command" ]] || exit 0
exec swaymsg -- "$command"
