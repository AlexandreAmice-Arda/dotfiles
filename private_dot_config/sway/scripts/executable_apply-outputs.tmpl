#!/usr/bin/env bash
set -euo pipefail

outputs=$(swaymsg --raw --type get_outputs)

name_for_serial() {
    jq -r --arg serial "$1" '.[] | select(.serial == $serial) | .name' <<< "$outputs" | head -n 1
}

configure_output() {
    local name=$1 mode=$2 transform=$3 position=$4
    local position_x position_y
    read -r position_x position_y <<< "$position"
    swaymsg -- output "$name" mode "$mode" scale 1 \
        transform "$transform" pos "$position_x" "$position_y"
}

{{ $displays := .desktop.profiles.amice_workstation.displays -}}
office_left=$(name_for_serial {{ $displays.office_left.serial }})
office_center=$(name_for_serial {{ $displays.office_center.serial }})
office_right=$(name_for_serial {{ $displays.office_right.serial }})
home_left=$(name_for_serial {{ $displays.home_left.serial }})
home_right=$(name_for_serial {{ $displays.home_right.serial }})
laptop=$(jq -r --arg name "{{ $displays.laptop.name }}" \
    '.[] | select(.name == $name) | .name' <<< "$outputs" | head -n 1)

if [[ -n "$office_left" && -n "$office_center" && -n "$office_right" && -n "$laptop" ]]; then
    configure_output "$office_left" "{{ $displays.office_left.mode }}" \
        "{{ $displays.office_left.transform }}" "{{ $displays.office_left.position }}"
    configure_output "$office_center" "{{ $displays.office_center.mode }}" \
        "{{ $displays.office_center.transform }}" "{{ $displays.office_center.position }}"
    configure_output "$office_right" "{{ $displays.office_right.mode }}" \
        "{{ $displays.office_right.transform }}" "{{ $displays.office_right.position }}"
    configure_output "$laptop" "{{ $displays.laptop.mode }}" normal \
        "{{ $displays.laptop.office_position }}"
elif [[ -n "$home_left" && -n "$home_right" && -n "$laptop" ]]; then
    configure_output "$home_left" "{{ $displays.home_left.mode }}" \
        "{{ $displays.home_left.transform }}" "{{ $displays.home_left.position }}"
    configure_output "$home_right" "{{ $displays.home_right.mode }}" \
        "{{ $displays.home_right.transform }}" "{{ $displays.home_right.position }}"
    configure_output "$laptop" "{{ $displays.laptop.mode }}" normal \
        "{{ $displays.laptop.home_position }}"
elif [[ -n "$laptop" ]]; then
    configure_output "$laptop" "{{ $displays.laptop.mode }}" normal \
        "{{ $displays.laptop.fallback_position }}"
fi
