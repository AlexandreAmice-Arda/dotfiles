#!/usr/bin/env bash
set -euo pipefail

if pgrep -u "$(id -u)" -f '/pcloud.bin' >/dev/null; then
    exit 0
fi

pcloud_launcher="$HOME/.config/pcloud/pcloud-launcher.sh"
if [ -x "$pcloud_launcher" ]; then
    exec "$pcloud_launcher"
fi

pcloud_appimage="$HOME/.local/opt/pcloud/pCloud.AppImage"
[ -x "$pcloud_appimage" ] || exit 0
exec "$pcloud_appimage"
