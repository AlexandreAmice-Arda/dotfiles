#!/usr/bin/env bash
set -euo pipefail

outputs=$(swaymsg --raw --type get_outputs)

name_for_serial() {
    jq -r --arg serial "$1" \
        '.[] | select(.active and .serial == $serial) | .name' \
        <<< "$outputs" | head -n 1
}

# Monitor 2 is the main monitor. Prefer the U3011 in the four-display setup,
# then the right-hand SE2719HR in the alternate setup, then the laptop.
notification_output=$(name_for_serial PH5NY1BH326L)
[[ -n "$notification_output" ]] || notification_output=$(name_for_serial 6N45XC3)
[[ -n "$notification_output" ]] || notification_output=eDP-1

if [[ ${MAKO_DRY_RUN:-0} == 1 ]]; then
    printf '%s\n' "$notification_output"
    exit 0
fi

exec mako --output "$notification_output"
