# Common dialogs float rather than consuming a tile.
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable

# Cloudflare's main window requests floating; keep it in the normal layout.
for_window [app_id="^warp-taskbar$"] floating disable
for_window [class="(?i)^warp-taskbar$"] floating disable

# Communication apps share workspace 10 on every Sway host.
assign [app_id="^slack$"] workspace number $ws10
assign [class="(?i)^slack$"] workspace number $ws10

# Persistent terminals use workspace 9; ordinary foot-current windows stay in
# the focused workspace.
assign [app_id="^foot$"] workspace number $ws9
assign [class="(?i)^foot$"] workspace number $ws9
