# =============================================================================
# Sway — stable Ubuntu/Kinesis trial
# =============================================================================
#
# Super is the primary modifier. Super+Space and Super+Shift+Space are
# intentionally unused. Search and execute commands with Super+/.
# Search annotations use: #@ shortcut :: description :: sway command

set $mod Mod4
set $term foot
set $menu wofi --show drun

font pango:JetBrains Mono 10
default_border pixel 2
gaps inner 6
gaps outer 3
focus_follows_mouse no

# Keep a complete, consistent cursor set across native Wayland applications.
seat * xcursor_theme Adwaita 24

# Generated from the shared Tokyo Night palette in .chezmoidata.yaml.
client.focused          #{{ .desktop.theme.blue }} #{{ .desktop.theme.background }} #{{ .desktop.theme.foreground }} #{{ .desktop.theme.blue }} #{{ .desktop.theme.blue }}
client.focused_inactive #{{ .desktop.theme.surface_alt }} #{{ .desktop.theme.background }} #a9b1d6 #{{ .desktop.theme.surface_alt }} #{{ .desktop.theme.surface_alt }}
client.unfocused        #{{ .desktop.theme.surface }} #{{ .desktop.theme.background }} #{{ .desktop.theme.muted }} #{{ .desktop.theme.surface }} #{{ .desktop.theme.surface }}
client.urgent           #{{ .desktop.theme.pink }} #{{ .desktop.theme.pink }} #{{ .desktop.theme.background }} #{{ .desktop.theme.pink }} #{{ .desktop.theme.pink }}
client.placeholder      #{{ .desktop.theme.surface_alt }} #{{ .desktop.theme.background }} #{{ .desktop.theme.muted }} #{{ .desktop.theme.surface_alt }} #{{ .desktop.theme.surface_alt }}

include ~/.config/sway/outputs.conf
output * bg ~/.local/share/tokyo-night/wallpapers/midnight.png fill

# Session integration
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
exec ~/.local/bin/swaync
exec_always ~/.config/sway/scripts/start-waybar
exec nm-applet --indicator
exec ~/.config/sway/scripts/start-polkit-agent
{{ if eq .desktopProfile "amice-workstation" -}}
exec_always ~/.config/sway/scripts/apply-outputs
{{ end -}}
exec_always ~/.local/bin/apply-appearance --restore --quiet

# Idle locking/display power-off remains opt-in until the lock screen is tested
# on each machine profile.
# exec swayidle -w \
#     timeout 600 'gtklock' \
#     timeout 900 'swaymsg "output * power off"' \
#         resume 'swaymsg "output * power on"' \
#     before-sleep 'gtklock --daemonize'

input type:touchpad {
    tap enabled
    dwt enabled
    natural_scroll enabled
}

floating_modifier $mod normal

# Discoverability and launching
#@ Super+/ :: Search and execute Sway commands :: exec ~/.config/sway/scripts/keybindings
bindsym $mod+slash exec ~/.config/sway/scripts/keybindings
#@ Palette only :: Configure displays graphically :: exec wdisplays
{{ if eq .desktopProfile "amice-workstation" -}}
#@ Palette only :: Arrange restored VS Code windows on monitors 1-4 :: exec ~/.config/sway/scripts/arrange-code-windows
{{ end -}}
#@ Super+Return :: Open Foot and attach to tmux main :: exec foot
bindsym $mod+Return exec $term
#@ Super+d :: Open application launcher :: exec wofi --show drun
bindsym $mod+d exec $menu
#@ Super+Alt+q :: Close focused window :: kill
bindsym $mod+Mod1+q kill
#@ Super+Shift+c :: Reload Sway configuration :: reload
bindsym $mod+Shift+c reload
#@ Super+Shift+e :: Log out of Sway with confirmation :: exec swaynag -t warning -m 'Exit Sway and return to the login screen?' -B 'Yes, exit Sway' 'swaymsg exit'
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'Exit Sway and return to the login screen?' \
    -B 'Yes, exit Sway' 'swaymsg exit'
#@ Super+Shift+x :: Lock screen :: exec gtklock
bindsym $mod+Shift+x exec gtklock
#@ Super+Alt+Space :: Open graphical system controls :: exec ~/.config/sway/scripts/system-menu
bindsym $mod+Mod1+space exec ~/.config/sway/scripts/system-menu
#@ Super+p :: Open lock, suspend, logout, restart, and shutdown menu :: exec ~/.config/sway/scripts/power-menu
bindsym $mod+p exec ~/.config/sway/scripts/power-menu
#@ Super+n :: Hide the latest notification popup but keep it in history :: exec ~/.local/bin/swaync-client --hide-latest --skip-wait
bindsym $mod+n exec ~/.local/bin/swaync-client --hide-latest --skip-wait
#@ Super+Shift+n :: Toggle notification history :: exec ~/.local/bin/swaync-client --toggle-panel --skip-wait
bindsym $mod+Shift+n exec ~/.local/bin/swaync-client --toggle-panel --skip-wait
#@ Super+Left Ctrl+n :: Clear all notifications :: exec ~/.local/bin/swaync-client --close-all --skip-wait
bindsym $mod+Ctrl+n exec ~/.local/bin/swaync-client --close-all --skip-wait

# Focus — generated from .chezmoidata.yaml
{{ range .desktop.directions }}
#@ Super+{{ .key }} :: Focus {{ lower .label }} :: focus {{ .name }}
bindsym $mod+{{ .key }} focus {{ .name }}
{{ end }}
#@ Super+a :: Focus parent container :: focus parent
bindsym $mod+a focus parent
#@ Palette only :: Toggle focus between tiled and floating windows :: focus mode_toggle
#@ Palette only :: Move focused window to the monitor on the left :: move container to output left
#@ Palette only :: Move focused window to the monitor below :: move container to output down
#@ Palette only :: Move focused window to the monitor above :: move container to output up
#@ Palette only :: Move focused window to the monitor on the right :: move container to output right

# Move windows — generated from .chezmoidata.yaml
{{ range .desktop.directions }}
#@ Super+Alt+{{ .key }} :: Move focused window {{ .name }} :: move {{ .name }}
bindsym $mod+Mod1+{{ .key }} move {{ .name }}
bindsym $mod+Mod1+{{ .label }} move {{ .name }}
{{ end }}

# Move an entire workspace between monitors. Use the left Ctrl thumb key.
#@ Super+Left Ctrl+h :: Move workspace to the monitor on the left :: move workspace to output left
bindsym $mod+Ctrl+h move workspace to output left
#@ Super+Left Ctrl+j :: Move workspace to the monitor below :: move workspace to output down
bindsym $mod+Ctrl+j move workspace to output down
#@ Super+Left Ctrl+k :: Move workspace to the monitor above :: move workspace to output up
bindsym $mod+Ctrl+k move workspace to output up
#@ Super+Left Ctrl+l :: Move workspace to the monitor on the right :: move workspace to output right
bindsym $mod+Ctrl+l move workspace to output right

# Workspaces — generated from .chezmoidata.yaml
{{ range .desktop.workspaces }}
set $ws{{ .name }} "{{ .name }}"
{{ end }}

{{ if eq .desktopProfile "amice-workstation" -}}
# Workstation-only monitor roles use stable identities because DP connector
# numbers can change after a reboot. Portable hosts let Sway place workspaces.
workspace $ws1 output "Dell Inc. DELL U2715H H7YCC6B70Y1S" "Dell Inc. DELL SE2719HR 19K8JB3" eDP-1
workspace $ws2 output "Dell Inc. DELL U3011 PH5NY1BH326L" "Dell Inc. DELL SE2719HR 6N45XC3" eDP-1
workspace $ws3 output "Ancor Communications Inc ASUS PB278 C9LMTF003960" eDP-1
workspace $ws4 output eDP-1
workspace $ws5 output "Dell Inc. DELL U2715H H7YCC6B70Y1S" "Dell Inc. DELL SE2719HR 19K8JB3" eDP-1
workspace $ws6 output "Dell Inc. DELL U3011 PH5NY1BH326L" "Dell Inc. DELL SE2719HR 6N45XC3" eDP-1
workspace $ws7 output "Ancor Communications Inc ASUS PB278 C9LMTF003960" eDP-1
workspace $ws8 output eDP-1
workspace $ws9 output "Dell Inc. DELL U2715H H7YCC6B70Y1S" "Dell Inc. DELL SE2719HR 19K8JB3" eDP-1
workspace $ws10 output eDP-1
{{ end }}

# Fixed-purpose applications use both native-Wayland and XWayland variants.
# VS Code and Chrome are distributed across multiple workspaces by the startup
# helper; later windows remain on the workspace where the user opens them.
assign [app_id="^foot$"] workspace number $ws9
assign [class="(?i)^foot$"] workspace number $ws9
assign [app_id="^terminator$"] workspace number $ws9
assign [class="(?i)^terminator$"] workspace number $ws9
{{ if eq .desktopProfile "amice-workstation" -}}
assign [app_id="^signal$"] workspace number $ws10
assign [class="(?i)^signal$"] workspace number $ws10
assign [app_id="^slack$"] workspace number $ws10
assign [class="(?i)^slack$"] workspace number $ws10

# pCloud must stay running for the mount, but its main window should not take a
# tile. Super+- can reveal it from the scratchpad when needed.
for_window [app_id="^pcloud$"] move scratchpad
for_window [class="(?i)^pcloud$"] move scratchpad
{{ end }}

{{ if eq .desktopProfile "amice-workstation" -}}
exec ~/.config/sway/scripts/start-pcloud
exec ~/.config/sway/scripts/start-session-apps
{{ end }}

{{ range .desktop.workspaces }}
#@ Super+{{ .key }} :: Switch to workspace {{ .name }} :: workspace number {{ .name }}
bindsym $mod+{{ .key }} workspace number $ws{{ .name }}
#@ Super+Shift+{{ .key }} :: Move window to workspace {{ .name }} :: move container to workspace number {{ .name }}
bindsym $mod+Shift+{{ .key }} move container to workspace number $ws{{ .name }}
{{ end }}
#@ Super+Tab :: Switch to the previous workspace :: workspace back_and_forth
bindsym $mod+Tab workspace back_and_forth

# Layout
#@ Super+Alt+b :: Make the next split horizontal :: splith
bindsym $mod+Mod1+b splith
#@ Super+Alt+v :: Make the next split vertical :: splitv
bindsym $mod+Mod1+v splitv
#@ Super+s :: Use stacking layout :: layout stacking
bindsym $mod+s layout stacking
#@ Super+w :: Use tabbed layout :: layout tabbed
bindsym $mod+w layout tabbed
#@ Super+e :: Toggle split layout :: layout toggle split
bindsym $mod+e layout toggle split
#@ Super+f :: Toggle fullscreen :: fullscreen
bindsym $mod+f fullscreen
#@ Super+Shift+f :: Toggle floating for the focused window :: floating toggle
bindsym $mod+Shift+f floating toggle

# Scratchpad
#@ Super+Shift+- :: Send focused window to scratchpad :: move scratchpad
bindsym $mod+Shift+minus move scratchpad
#@ Super+- :: Show or cycle scratchpad windows :: scratchpad show
bindsym $mod+minus scratchpad show

# Resize mode
#@ Super+r :: Enter resize mode; H/J/K/L resize and Enter/Escape exits :: mode "resize"
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 20px
    bindsym j resize grow height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow width 20px
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Screenshots
#@ Print :: Screenshot all outputs to the clipboard :: exec grim - | wl-copy
bindsym Print exec grim - | wl-copy
#@ Shift+Print :: Select a screenshot region and copy it :: exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy

# Audio, media, and brightness
#@ Volume Up :: Raise volume 5 percent :: exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
#@ Volume Down :: Lower volume 5 percent :: exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
#@ Volume Mute :: Toggle speaker mute :: exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
#@ Microphone Mute :: Toggle microphone mute :: exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
#@ Media Play/Pause :: Play or pause media :: exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
#@ Media Next :: Play next media track :: exec playerctl next
bindsym --locked XF86AudioNext exec playerctl next
#@ Media Previous :: Play previous media track :: exec playerctl previous
bindsym --locked XF86AudioPrev exec playerctl previous
#@ Brightness Up :: Increase laptop brightness 5 percent :: exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +5%
#@ Brightness Down :: Decrease laptop brightness 5 percent :: exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
#@ Super+Alt+= :: Increase laptop brightness 5 percent :: exec brightnessctl set +5%
bindsym $mod+Mod1+equal exec brightnessctl set +5%
#@ Super+Alt+- :: Decrease laptop brightness 5 percent :: exec brightnessctl set 5%-
bindsym $mod+Mod1+minus exec brightnessctl set 5%-

# Common dialogs float instead of consuming a tile.
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
