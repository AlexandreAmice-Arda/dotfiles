{
  "label": "lock",
  "action": "$HOME/.local/bin/session-action lock",
  "text": "Lock",
  "keybind": "l"
}
{
  "label": "suspend",
  "action": "$HOME/.local/bin/session-action suspend",
  "text": "Suspend",
  "keybind": "u"
}
{
  "label": "logout",
  "action": "$HOME/.local/bin/session-action logout",
  "text": "Log out",
  "keybind": "e"
}
{
  "label": "reboot",
  "action": "$HOME/.local/bin/session-action reboot",
  "text": "Restart",
  "keybind": "r"
}
{
  "label": "shutdown",
  "action": "$HOME/.local/bin/session-action poweroff",
  "text": "Shut down",
  "keybind": "s"
}
