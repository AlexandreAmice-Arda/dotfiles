# Generated by chezmoi from the shared Tokyo Night desktop schema.
font-family = {{ .desktop.fonts.terminal }}
# Keep Ghostty larger than Foot's shared terminal size.
font-size = 15

window-padding-x = {{ .desktop.layout.terminal_padding_x }}
window-padding-y = {{ .desktop.layout.terminal_padding_y }}
window-padding-balance = true
# Machine-local opacity is loaded after the managed configuration.
config-file = ?{{ .chezmoi.homeDir }}/.local/state/tokyo-night/ghostty-opacity.conf
background-blur = false
unfocused-split-opacity = 1

# Foot delegates decorations to Sway; hide the macOS terminal title bar.
macos-titlebar-style = hidden
macos-option-as-alt = true

# Keep Ctrl-Backspace consistent with Foot and readline shells.
keybind = ctrl+backspace=text:\x17

background = {{ .desktop.theme.background }}
foreground = {{ .desktop.theme.foreground }}
selection-foreground = {{ .desktop.theme.background }}
selection-background = {{ .desktop.theme.blue }}

# Match Foot's blinking beam and default foreground cursor color.
cursor-style = bar
cursor-style-blink = true
cursor-color = {{ .desktop.theme.foreground }}

palette = 0={{ .desktop.theme.surface }}
palette = 1={{ .desktop.theme.pink }}
palette = 2={{ .desktop.theme.green }}
palette = 3={{ .desktop.theme.yellow }}
palette = 4={{ .desktop.theme.blue }}
palette = 5={{ .desktop.theme.purple }}
palette = 6={{ .desktop.theme.cyan }}
palette = 7={{ .desktop.theme.foreground_alt }}
palette = 8={{ .desktop.theme.muted }}
palette = 9={{ .desktop.theme.bright.pink }}
palette = 10={{ .desktop.theme.bright.green }}
palette = 11={{ .desktop.theme.bright.yellow }}
palette = 12={{ .desktop.theme.bright.blue }}
palette = 13={{ .desktop.theme.bright.purple }}
palette = 14={{ .desktop.theme.bright.cyan }}
palette = 15={{ .desktop.theme.foreground }}
