# Generated by chezmoi. Runtime opacity is stored outside chezmoi state.
[main]
font={{ .desktop.fonts.terminal }}:size={{ .desktop.layout.terminal_font_size }}
font-bold={{ .desktop.fonts.terminal }}:weight=bold:size={{ .desktop.layout.terminal_font_size }}
font-italic={{ .desktop.fonts.terminal }}:slant=italic:size={{ .desktop.layout.terminal_font_size }}
pad={{ .desktop.layout.terminal_padding_x }}x{{ .desktop.layout.terminal_padding_y }} center
dpi-aware=yes
include={{ .chezmoi.homeDir }}/.local/state/tokyo-night/foot-opacity.ini

[scrollback]
lines=10000

[cursor]
style=beam
blink=yes

[text-bindings]
# Send the conventional readline "erase previous word" byte. Without this,
# Foot emits Ctrl-H, which terminals cannot distinguish from another binding.
\x17=Control+BackSpace

[colors-dark]
foreground={{ .desktop.theme.foreground }}
background={{ .desktop.theme.background }}
regular0={{ .desktop.theme.surface }}
regular1={{ .desktop.theme.pink }}
regular2={{ .desktop.theme.green }}
regular3={{ .desktop.theme.yellow }}
regular4={{ .desktop.theme.blue }}
regular5={{ .desktop.theme.purple }}
regular6={{ .desktop.theme.cyan }}
regular7={{ .desktop.theme.foreground_alt }}
bright0={{ .desktop.theme.muted }}
bright1={{ .desktop.theme.bright.pink }}
bright2={{ .desktop.theme.bright.green }}
bright3={{ .desktop.theme.bright.yellow }}
bright4={{ .desktop.theme.bright.blue }}
bright5={{ .desktop.theme.bright.purple }}
bright6={{ .desktop.theme.bright.cyan }}
bright7={{ .desktop.theme.foreground }}
selection-foreground={{ .desktop.theme.background }}
selection-background={{ .desktop.theme.blue }}
urls={{ .desktop.theme.cyan }}

[csd]
preferred=server
