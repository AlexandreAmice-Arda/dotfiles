{{ template "tokyo-night.css" . }}

window {
  background-color: @tn_background_deep;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  color: @tn_foreground;
}

#window-box {
  background: alpha(@tn_background, 0.88);
  border: 1px solid @tn_blue;
  border-radius: 24px;
  box-shadow: 0 18px 55px alpha(black, 0.48);
  padding: 38px 48px;
}

#clock-label {
  color: @tn_foreground;
  font-family: "{{ .desktop.fonts.interface }}";
  font-size: 42px;
  font-weight: 700;
  margin-bottom: 18px;
}

#input-label, #warning-label {
  color: @tn_foreground_alt;
  font-family: "{{ .desktop.fonts.interface }}";
}

#input-field {
  color: @tn_foreground;
  background: @tn_surface;
  border: 1px solid @tn_surface_alt;
  border-radius: 13px;
  caret-color: @tn_cyan;
  padding: 11px 14px;
}

#input-field:focus {
  border-color: @tn_cyan;
  box-shadow: 0 0 0 3px alpha(@tn_cyan, 0.13);
}

#warning-label { color: @tn_pink; }
