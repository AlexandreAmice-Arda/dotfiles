#!/usr/bin/env bash
set -euo pipefail

source_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
work_dir=$(mktemp -d)
trap 'rm -rf -- "$work_dir"' EXIT

ok() { printf 'ok      %s\n' "$*"; }
warn() { printf 'warning %s\n' "$*" >&2; }
fail() { printf 'error   %s\n' "$*" >&2; exit 1; }

materialize() {
    local label=$1 os=$2 profile=$3 home override
    home="$work_dir/$label/home"
    mkdir -p "$home"
    override=$(jq -nc \
        --arg os "$os" --arg home "$home" --arg profile "$profile" \
        '{desktopProfile:$profile, gitName:"Validation User",
          gitEmail:"validation@example.invalid",
          isAmiceWorkstation:($os == "linux" and $profile == "amice-workstation"),
          chezmoi:{os:$os, homeDir:$home}}')

    chezmoi --source "$source_root" --destination "$home" \
        --persistent-state "$work_dir/$label/state.boltdb" \
        --override-data "$override" --no-tty apply --force \
        --exclude externals
    ok "materialized $label target"
    printf '%s\n' "$home"
}

check_shell_tree() {
    local root=$1 script
    while IFS= read -r -d '' script; do
        case $(head -n 1 "$script") in
            '#!'*sh*) bash -n "$script" ;;
        esac
    done < <(find "$root" -type f -perm -u+x -print0)
}

require_file() {
    [ -f "$1" ] || fail "missing rendered file: $1"
}

require_absent() {
    [ ! -e "$1" ] || fail "platform/profile leak: $1"
}

linux_portable=$(materialize linux-portable linux portable | tail -n 1)
linux_workstation=$(materialize linux-workstation linux amice-workstation | tail -n 1)
mac_portable=$(materialize mac-portable darwin portable | tail -n 1)

# Profile and platform boundaries are part of the contract, not merely syntax.
require_absent "$linux_portable/.config/sway/scripts/apply-outputs"
require_absent "$linux_portable/.config/terminator"
require_absent "$linux_workstation/.config/sway/scripts/apply-outputs"
require_absent "$linux_portable/.config/kanshi"
require_absent "$linux_portable/.config/systemd/user/sway-kanshi.service"
require_absent "$linux_portable/.config/sway/scripts/output-profile-applied"
require_file "$linux_workstation/.config/kanshi/config"
require_file "$linux_workstation/.config/sway/scripts/output-profile-applied"
require_file "$linux_workstation/.config/systemd/user/sway-kanshi.service"
require_file "$linux_workstation/.config/sway/scripts/start-work-session"
require_absent "$linux_workstation/.config/sway/scripts/start-session-apps"
require_file "$linux_workstation/.config/systemd/user/sway-signal.service"
require_file "$linux_workstation/.config/systemd/user/sway-slack.service"
require_absent "$linux_portable/.config/systemd/user/sway-signal.service"
require_absent "$linux_portable/.config/systemd/user/sway-slack.service"
require_file "$linux_workstation/.config/terminator/config"
require_file "$mac_portable/.config/aerospace/aerospace.toml"
require_file "$mac_portable/.config/ghostty/config.ghostty"
require_file "$mac_portable/.zshrc"
require_absent "$mac_portable/.config/sway"
require_absent "$mac_portable/.config/kanshi"
require_absent "$mac_portable/.config/terminator"
require_absent "$mac_portable/.local/share/applications/signal-desktop.desktop"
ok 'platform and profile boundaries'

for home in "$linux_portable" "$linux_workstation" "$mac_portable"; do
    require_absent "$home/docs"
    require_absent "$home/scripts"
    require_absent "$home/tests"
    require_absent "$home/packages"
    require_file "$home/.config/starship.toml"
    require_file "$home/.config/atuin/config.toml"
    require_file "$home/.config/herdr/config.toml"
    require_file "$home/.config/nvim/init.lua"
    require_file "$home/.config/nvim/lua/config/lazy.lua"
    require_file "$home/.config/nvim/lazy-lock.json"
    require_file "$home/.local/bin/starship"
    require_file "$home/.local/bin/atuin"
    require_file "$home/.local/bin/herdr"
    require_file "$home/.local/bin/terminal-agents"
    require_file "$home/.local/bin/nvim"
    require_file "$home/.local/bin/fd"
    require_file "$home/.local/bin/tree-sitter"
    require_absent "$home/.local/share/atuin"
    require_absent "$home/.local/share/nvim"
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' \
        "$home/.config/starship.toml"
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' \
        "$home/.config/atuin/config.toml"
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' \
        "$home/.config/herdr/config.toml"
    jq empty "$home/.config/nvim/lazy-lock.json"
    jq empty "$home/.config/nvim/lazyvim.json"
    jq -e 'all(.[]; (.commit | type == "string" and length == 40))' \
        "$home/.config/nvim/lazy-lock.json" >/dev/null \
        || fail 'LazyVim lockfile contains an invalid plugin commit'
done
if command -v herdr >/dev/null 2>&1; then
    HERDR_CONFIG_PATH="$linux_portable/.config/herdr/config.toml" \
        herdr config check >/dev/null
else
    warn 'herdr unavailable; skipped native Herdr config validation'
fi
grep -Fq 'name = "tokyo-night"' "$linux_portable/.config/herdr/config.toml" \
    || fail 'Herdr does not use the shared desktop theme family'
grep -Fq 'pane_history = false' "$linux_portable/.config/herdr/config.toml" \
    || fail 'Herdr pane-history persistence is not explicitly disabled'
python3 - "$linux_portable/.config/starship.toml" <<'PY'
import sys
import tomllib

with open(sys.argv[1], "rb") as config_file:
    config = tomllib.load(config_file)
expected = "${custom.remote}$directory$line_break$git_branch$git_status$cmd_duration$line_break$character"
if config.get("format") != expected:
    raise SystemExit("Starship prompt does not keep path, context, and input on separate lines")
if config["directory"].get("truncation_length") != 0:
    raise SystemExit("Starship directory path is still truncated")
if config["directory"].get("truncate_to_repo") is not False:
    raise SystemExit("Starship directory path still collapses to the repository root")
if "time" in config:
    raise SystemExit("Starship time module must remain omitted")
PY
require_file "$linux_portable/.local/libexec/waybar/desktop-temperature"
require_file "$linux_workstation/.local/libexec/waybar/desktop-temperature"
require_absent "$linux_portable/.local/bin/desktop-temperature"
require_absent "$linux_workstation/.local/bin/desktop-temperature"
require_absent "$mac_portable/.local/libexec/waybar/desktop-temperature"
expected_wallpaper="$linux_portable/.local/share/tokyo-night/wallpapers/midnight.png"
[[ $(readlink "$linux_portable/.local/state/tokyo-night/wallpaper.png") == "$expected_wallpaper" ]] \
    || fail 'wallpaper state symlink does not target the external asset directory'
grep -Fq 'atuin init bash --disable-up-arrow --disable-ai' \
    "$linux_portable/.bashrc" \
    || fail 'Bash Atuin integration can replace the Up arrow or enable AI'
grep -Fq 'atuin init zsh --disable-up-arrow --disable-ai' \
    "$mac_portable/.zshrc" \
    || fail 'Zsh Atuin integration can replace the Up arrow or enable AI'
grep -Fq 'enter_accept = false' "$linux_portable/.config/atuin/config.toml" \
    || fail 'Atuin selections are not configured for review before execution'

# Super+T starts a non-login Bash beneath Foot. Reproduce its minimal inherited
# PATH and ensure the managed wrapper is visible before Starship initializes.
mkdir -p "$linux_portable/.local/opt/starship-1.26.0"
cat > "$linux_portable/.local/opt/starship-1.26.0/starship" <<'EOF'
#!/bin/sh
if [ "${1:-} ${2:-}" = 'init bash' ]; then
    printf 'export STARSHIP_SHELL=bash\n'
fi
EOF
chmod +x "$linux_portable/.local/opt/starship-1.26.0/starship"
# The probe command expands inside the clean child Bash, not this validator.
# shellcheck disable=SC2016
shell_probe=$(env -i \
    HOME="$linux_portable" USER=validation SHELL=/bin/bash \
    TERM=xterm-256color PATH=/usr/bin:/bin \
    bash --noprofile --rcfile "$linux_portable/.bashrc" -ic \
    'printf "%s|%s\n" "$(command -v starship)" "${STARSHIP_SHELL:-}"' \
    2>/dev/null | tail -n 1)
[[ $shell_probe == "$linux_portable/.local/bin/starship|bash" ]] \
    || fail 'non-login Bash cannot initialize Starship from ~/.local/bin'
ok 'portable CLI configs contain no account or runtime state'

for external_case in linux-amd64 linux-arm64 darwin-arm64; do
    external_os=${external_case%-*}
    external_arch=${external_case#*-}
    external_manifest="$work_dir/chezmoiexternal-$external_case.toml"
    external_override=$(jq -nc --arg os "$external_os" --arg arch "$external_arch" \
        '{chezmoi:{os:$os, arch:$arch}}')
    chezmoi --source "$source_root" --override-data "$external_override" \
        execute-template --file "$source_root/.chezmoiexternal.toml.tmpl" \
        > "$external_manifest"
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' \
        "$external_manifest"
done
grep -Fq 'starship-x86_64-unknown-linux-musl' \
    "$work_dir/chezmoiexternal-linux-amd64.toml" \
    || fail 'x86-64 Starship external is missing'
grep -Fq 'atuin-aarch64-unknown-linux-gnu' \
    "$work_dir/chezmoiexternal-linux-arm64.toml" \
    || fail 'ARM64 Atuin external is missing'
grep -Fq 'nvim-linux-x86_64.tar.gz' \
    "$work_dir/chezmoiexternal-linux-amd64.toml" \
    || fail 'x86-64 Neovim external is missing'
grep -Fq 'nvim-linux-arm64.tar.gz' \
    "$work_dir/chezmoiexternal-linux-arm64.toml" \
    || fail 'ARM64 Neovim external is missing'
grep -Fq 'tree-sitter-cli-linux-x64.zip' \
    "$work_dir/chezmoiexternal-linux-amd64.toml" \
    || fail 'x86-64 tree-sitter CLI external is missing'
grep -Fq 'tree-sitter-cli-linux-arm64.zip' \
    "$work_dir/chezmoiexternal-linux-arm64.toml" \
    || fail 'ARM64 tree-sitter CLI external is missing'
grep -Fq 'herdr-linux-x86_64' \
    "$work_dir/chezmoiexternal-linux-amd64.toml" \
    || fail 'x86-64 Herdr external is missing'
grep -Fq '2a02fed16beb651ef006e1d43f048f652ca4dc58ad053cd2d44450563d5c54b7' \
    "$work_dir/chezmoiexternal-linux-amd64.toml" \
    || fail 'x86-64 Herdr checksum is missing'
grep -Fq 'herdr-linux-aarch64' \
    "$work_dir/chezmoiexternal-linux-arm64.toml" \
    || fail 'ARM64 Herdr external is missing'
grep -Fq 'f4ccf4de745f2cb9a39a983e9ba3703dad50ec2a58dea83026ceab721bbd8d9e' \
    "$work_dir/chezmoiexternal-linux-arm64.toml" \
    || fail 'ARM64 Herdr checksum is missing'
if grep -Eq 'starship|atuin|herdr|neovim|tree-sitter-cli|JetBrainsMono' \
    "$work_dir/chezmoiexternal-darwin-arm64.toml"; then
    fail 'Linux fallback releases leaked into the macOS external manifest'
fi
wallpaper_url='https://github.com/AlexandreAmice/dotfiles-assets/releases/download/wallpapers-v1/tokyo-night-wallpapers-v1.tar.gz'
for linux_manifest in \
    "$work_dir/chezmoiexternal-linux-amd64.toml" \
    "$work_dir/chezmoiexternal-linux-arm64.toml"
do
    grep -Fq "$wallpaper_url" "$linux_manifest" \
        || fail 'Linux wallpaper external is missing its versioned release URL'
    grep -Fq '266d37158697358a171c66e68e484440348a45800e9b531848da8b11c485b020' \
        "$linux_manifest" || fail 'Linux wallpaper external checksum is missing'
    grep -Fq 'stripComponents = 1' "$linux_manifest" \
        || fail 'Linux wallpaper external does not strip its top-level directory'
    grep -Fq 'exact = true' "$linux_manifest" \
        || fail 'Linux wallpaper external is not exact'
done
if grep -Fq 'tokyo-night-wallpapers' "$work_dir/chezmoiexternal-darwin-arm64.toml"; then
    fail 'Linux wallpaper external leaked into the macOS manifest'
fi
ok 'multi-architecture external release manifests'

for package in kanshi fzf zoxide fd-find; do
    grep -Fxq "$package" "$source_root/packages/ubuntu.txt" \
        || fail "Ubuntu package is undeclared: $package"
done
for formula in atuin fd fzf herdr neovim starship tree-sitter-cli zoxide; do
    grep -Fqx "brew \"$formula\"" "$source_root/Brewfile" \
        || fail "Homebrew formula is undeclared: $formula"
done
grep -Fqx 'cask "font-jetbrains-mono-nerd-font"' "$source_root/Brewfile" \
    || fail 'Homebrew Nerd Font cask is undeclared'
ok 'platform dependency manifests'

for profile in office home mobile; do
    grep -Fq "profile $profile {" "$linux_workstation/.config/kanshi/config" \
        || fail "missing Kanshi profile: $profile"
done
grep -Fq 'exec ~/.config/sway/scripts/output-profile-applied' \
    "$linux_workstation/.config/kanshi/config" \
    || fail 'Kanshi profiles do not move the single Waybar after output changes'
if grep -E '^\s*output ' "$linux_workstation/.config/kanshi/config" \
    | grep -Ev '^\s*output ("[^"]+"|[^ ]+) enable '; then
    fail 'Kanshi profile contains an output that is not explicitly enabled'
fi
grep -Fq 'systemctl --user cat sway-kanshi.service' \
    "$linux_workstation/.config/sway/scripts/reload-desktop" \
    || fail 'Sway reload does not restore optional Kanshi output profiles'
ok 'Kanshi workstation profiles'

for home in "$linux_portable" "$linux_workstation"; do
    require_file "$home/.local/state/tokyo-night/foot-opacity.ini"
    [ -L "$home/.local/state/tokyo-night/wallpaper.png" ] \
        || fail "missing rendered wallpaper symlink: $home/.local/state/tokyo-night/wallpaper.png"

    if command -v sway >/dev/null 2>&1; then
        if ! HOME="$home" sway --unsupported-gpu --validate \
            --config "$home/.config/sway/config" >"$work_dir/sway.log" 2>&1; then
            cat "$work_dir/sway.log" >&2
            fail "invalid Sway config in $home"
        fi
    else
        warn 'sway unavailable; skipped Sway parser'
    fi

    if command -v foot >/dev/null 2>&1; then
        if ! HOME="$home" foot --check-config \
            --config "$home/.config/foot/foot.ini" >"$work_dir/foot.log" 2>&1; then
            cat "$work_dir/foot.log" >&2
            fail "invalid Foot config in $home"
        fi
    else
        warn 'foot unavailable; skipped Foot parser'
    fi

    jq empty "$home/.config/waybar/config.json"
    jq empty "$home/.config/swaync/config.json"
    check_shell_tree "$home"
done
ok 'Linux configs and shell syntax'

keybinding_catalog=$(
    SWAY_CONFIG_PATH="$linux_workstation/.config/sway/config" \
        "$linux_workstation/.config/sway/scripts/keybindings" --print
)
for expected_entry in \
    'Open a plain terminal without tmux' \
    'Open or resume an independent persistent tmux terminal' \
    'Open the agent-aware Herdr workspace' \
    'Open the deliberately shared tmux main session' \
    'Show workspace windows as tabs' \
    'Create another tmux window in this terminal session'
do
    grep -Fq "$expected_entry" <<< "$keybinding_catalog" \
        || fail "missing command-palette entry: $expected_entry"
done
ok 'Sway command palette includes generated fragments and terminal references'

if rg -n 'bindsym[[:space:]]+\$mod\+[^[:space:]]*(Return|space)' \
    "$linux_workstation/.config/sway/conf.d/50-keybindings.conf"
then
    fail 'Kinesis-incompatible Super chord uses Return or Space'
fi
grep -Fq "alt-t = 'exec-and-forget open -na Ghostty'" \
    "$mac_portable/.config/aerospace/aerospace.toml" \
    || fail 'macOS terminal shortcut is not the portable modifier+T chord'
grep -Fq "alt-shift-t = 'exec-and-forget open -na Ghostty --args -e $mac_portable/.local/bin/terminal-main'" \
    "$mac_portable/.config/aerospace/aerospace.toml" \
    || fail 'macOS persistent terminal is not explicit on modifier+Shift+T'
grep -Fq "alt-ctrl-t = 'exec-and-forget open -na Ghostty --args -e $mac_portable/.local/bin/terminal-agents'" \
    "$mac_portable/.config/aerospace/aerospace.toml" \
    || fail 'macOS agent terminal is not explicit on modifier+Ctrl+T'
if grep -Fq 'terminal-main' "$linux_portable/.config/foot/foot.ini"; then
    fail 'Foot still starts tmux implicitly'
fi
if grep -Fq 'terminal-main' "$mac_portable/.config/ghostty/config.ghostty"; then
    fail 'Ghostty still starts tmux implicitly'
fi
if grep -Fq 'terminal-agents' "$linux_portable/.config/foot/foot.ini"; then
    fail 'Foot still starts Herdr implicitly'
fi
if grep -Fq 'terminal-agents' "$mac_portable/.config/ghostty/config.ghostty"; then
    fail 'Ghostty still starts Herdr implicitly'
fi
grep -Fq "bindsym \$mod+t exec foot --app-id=foot-current" \
    "$linux_portable/.config/sway/conf.d/50-keybindings.conf" \
    || fail 'Sway plain terminal is not on Super+T'
grep -Fq "bindsym \$mod+Shift+t exec foot ~/.local/bin/terminal-main" \
    "$linux_portable/.config/sway/conf.d/50-keybindings.conf" \
    || fail 'Sway persistent terminal is not explicit on Super+Shift+T'
grep -Fq "bindsym \$mod+Ctrl+t exec foot ~/.local/bin/terminal-agents" \
    "$linux_portable/.config/sway/conf.d/50-keybindings.conf" \
    || fail 'Sway agent terminal is not explicit on Super+Ctrl+T'
ok 'Kinesis thumb-cluster ergonomics'

# Exercise the terminal adapter without touching the user's real tmux server.
fake_bin="$work_dir/fake-bin"
mkdir -p "$fake_bin"
cat > "$fake_bin/tmux" <<'EOF'
#!/bin/sh
case $1 in
    list-sessions)
        case $* in
            *session_attached*)
                case ${FAKE_TMUX_STATE:-empty} in
                    detached) printf 'terminal-2:1\nterminal-1:0\n' ;;
                    attached) printf 'terminal-1:1\nterminal-2:1\n' ;;
                    empty) exit 1 ;;
                esac
                ;;
            *)
                case ${FAKE_TMUX_STATE:-empty} in
                    detached) printf 'terminal-2\nterminal-1\n' ;;
                    attached) printf 'terminal-1\nterminal-2\n' ;;
                    empty) exit 1 ;;
                esac
                ;;
        esac
        ;;
    attach-session|new-session) printf '%s\n' "$*" ;;
esac
EOF
chmod +x "$fake_bin/tmux"

cat > "$fake_bin/herdr" <<'EOF'
#!/bin/sh
printf 'herdr%s\n' "${*:+ $*}"
EOF
chmod +x "$fake_bin/herdr"

terminal_adapter="$linux_portable/.local/bin/terminal-main"
adapter_result=$(PATH="$fake_bin:$PATH" FAKE_TMUX_STATE=detached "$terminal_adapter")
[[ $adapter_result == 'attach-session -t terminal-1' ]] \
    || fail 'persistent terminal did not resume the oldest detached session'
adapter_result=$(PATH="$fake_bin:$PATH" FAKE_TMUX_STATE=attached "$terminal_adapter")
[[ $adapter_result == 'new-session -s terminal-3' ]] \
    || fail 'persistent terminal did not allocate the next numbered session'
adapter_result=$(PATH="$fake_bin:$PATH" FAKE_TMUX_STATE=empty "$terminal_adapter")
[[ $adapter_result == 'new-session -s terminal-1' ]] \
    || fail 'persistent terminal did not bootstrap terminal-1'
adapter_result=$(PATH="$fake_bin:$PATH" "$terminal_adapter" --shared)
[[ $adapter_result == 'new-session -A -s main' ]] \
    || fail 'shared terminal escape hatch did not target main'
ok 'explicit persistent terminal allocation policy'

agent_adapter="$linux_portable/.local/bin/terminal-agents"
agent_path=$(env -u TMUX -u HERDR_ENV PATH="$fake_bin:$PATH" \
    "$agent_adapter" --check)
[[ $agent_path == "$fake_bin/herdr" ]] \
    || fail 'agent terminal did not resolve Herdr from PATH'
agent_result=$(env -u TMUX -u HERDR_ENV PATH="$fake_bin:$PATH" "$agent_adapter")
[[ $agent_result == herdr ]] \
    || fail 'agent terminal did not launch Herdr'
if PATH="$fake_bin:$PATH" TMUX=nested "$agent_adapter" >/dev/null 2>&1; then
    fail 'agent terminal allowed nesting inside tmux'
fi
if PATH="$fake_bin:$PATH" HERDR_ENV=1 "$agent_adapter" >/dev/null 2>&1; then
    fail 'agent terminal allowed nesting inside Herdr'
fi
ok 'agent terminal isolation policy'

power_fixture="$work_dir/power-supply/BAT0"
mkdir -p "$power_fixture"
printf 'Discharging\n' > "$power_fixture/status"
power_result=$(POWER_SUPPLY_ROOT="$work_dir/power-supply" \
    "$linux_portable/.local/bin/suspend-if-on-battery" --dry-run)
[[ $power_result == *'would lock and suspend'* ]] \
    || fail 'battery idle policy did not select suspend while discharging'
printf 'Charging\n' > "$power_fixture/status"
power_result=$(POWER_SUPPLY_ROOT="$work_dir/power-supply" \
    "$linux_portable/.local/bin/suspend-if-on-battery" --dry-run)
[[ $power_result == *'would remain awake'* ]] \
    || fail 'battery idle policy did not remain awake while charging'
ok 'battery-aware suspend policy'

python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' \
    "$mac_portable/.config/aerospace/aerospace.toml"
check_shell_tree "$mac_portable"
if command -v zsh >/dev/null 2>&1; then
    zsh -n "$mac_portable/.zprofile" "$mac_portable/.zshrc"
else
    warn 'zsh unavailable; skipped native Zsh parser'
fi
ok 'macOS configs and shell syntax'

if command -v systemd-analyze >/dev/null 2>&1; then
    unit_dir="$work_dir/units"
    mkdir -p "$unit_dir"
    for unit in \
        "$linux_portable/.config/systemd/user/"sway-*.service \
        "$linux_portable/.config/systemd/user/sway-session.target" \
        "$linux_workstation/.config/systemd/user/sway-kanshi.service"
    do
        # systemd expands %h through the account database, not $HOME. Point
        # verifier-only copies at the clean-room home it is actually checking.
        sed \
            -e "s|%h|$linux_portable|g" \
            -e 's|^ExecStart=/usr/bin/kanshi .*|ExecStart=/bin/true|' \
            "$unit" > "$unit_dir/${unit##*/}"
    done
    SYSTEMD_UNIT_PATH="$unit_dir:/usr/lib/systemd/user" \
        systemd-analyze --user verify "$unit_dir/"*
    ok 'systemd user units'
else
    warn 'systemd-analyze unavailable; skipped unit parser'
fi

if command -v shellcheck >/dev/null 2>&1; then
    while IFS= read -r -d '' script; do
        case $(head -n 1 "$script") in
            '#!'*sh*) shellcheck "$script" ;;
        esac
    done < <(find "$linux_workstation" "$mac_portable" -type f -perm -u+x -print0)
    shellcheck "$source_root/scripts/check-ubuntu" \
        "$source_root/scripts/install-agent-integrations" \
        "$source_root/scripts/install-ubuntu" \
        "$source_root/tests/validate-desktop"
    ok 'ShellCheck'
else
    warn 'shellcheck unavailable; syntax checks still ran (install the package for linting)'
fi

personal_pattern='/home/(amice|demo)|PH5NY1BH326L|H7YCC6B70Y1S|6N45XC3'
personal_pattern+='|C9LMTF003960|SNOPT_PATH|MOSEKLM|GUROBI_HOME|CUDA_PATH'
personal_pattern+='|AdmmPackageSplit|start-pcloud|sway-trial-system'
if rg -n "$personal_pattern" "$linux_portable" "$mac_portable"; then
    fail 'personal or workstation-specific data leaked into a portable target'
fi
ok 'portable targets contain no known workstation paths or display identities'

if rg -n --hidden \
    --glob '!**/.git/**' \
    --glob '!docs/**' \
    --glob '!README.md' \
    --glob '!.chezmoi.toml.tmpl' \
    --glob '!tests/**' \
    '\.desktopProfile[^\n]*amice-workstation|amice-workstation[^\n]*\.desktopProfile' \
    "$source_root"
then
    fail 'literal workstation profile comparison exists outside the config initializer or documentation'
fi
