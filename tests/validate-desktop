import json, sys
rules = json.load(open(sys.argv[1]))
def resolve(key, **context):
    context = dict(isMac=True, **context)
    def matches(condition):
        for term in condition.split(' && '):
            value = bool(context.get(term.lstrip('!'), False))
            if value == term.startswith('!'):
                return False
        return True
    return next((rule for rule in reversed(rules)
                 if rule['key'] == key and matches(rule['when'])), None)
