    "$source_root/scripts/install" \
    || fail 'fcft source checksum is missing'
grep -Fq "run_step 'Install Foot' install_foot" "$source_root/scripts/install" \
    || fail 'Ubuntu setup does not install a Herdr-compatible Foot version'
grep -Fq '07bd92f892457d0153d7fea53e838555f9753974a53a4d989d294b6e75c40104' \
    "$source_root/scripts/install" \
    || fail 'nwg-displays source checksum is missing'
