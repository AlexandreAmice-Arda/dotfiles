grep -Fq "open -a Slack" "$mac_portable/.config/aerospace/aerospace.toml" \
    || fail 'AeroSpace does not start Slack'
grep -Fq "if.app-id = 'com.tinyspeck.slackmacgap'" \
    "$mac_portable/.config/aerospace/aerospace.toml" \
    || fail 'AeroSpace Slack workspace assignment is missing'
ok 'platform dependency manifests'

for home in "$linux_portable" "$linux_workstation"; do
    grep -Fq 'sway-datetime.service' \
        "$home/.config/systemd/user/sway-session.target" \
        || fail 'automatic time-zone service is not part of the Sway session'
    grep -Fq 'XDG_CURRENT_DESKTOP=GNOME gnome-control-center system datetime' \
        "$home/.config/sway/scripts/system-menu" \
        || fail 'Sway control center does not launch GNOME date and time settings'
    for profile in Office Home Mobile; do
        jq -e --arg profile "$profile" \
            '.profiles | any(.label == $profile)' \
            "$home/.config/sway/display-layouts.json" >/dev/null \
            || fail "missing migrated display profile: $profile"
    done
    grep -Fq 'display-layouts daemon' \
        "$home/.config/systemd/user/sway-display-layouts.service" \
        || fail 'display layout daemon is not supervised by systemd'
    grep -Fq 'sway-display-layouts.service' \
        "$home/.config/systemd/user/sway-session.target" \
        || fail 'display layout daemon is not part of the Sway session'
    grep -Fq 'display-layouts" gui' \
        "$home/.config/sway/scripts/system-menu" \
        || fail 'Sway control center does not launch the display layout GUI'
    if grep -Eq '^workspace .* output ' "$home/.config/sway/conf.d/40-workspaces.conf"; then
        fail 'static workspace output rules conflict with display-layouts'
    fi
done
grep -Fq 'sway-display-layouts.service' \
    "$linux_workstation/.config/sway/scripts/reload-desktop" \
    || fail 'Sway reload does not restart the display layout manager'
